# =============================================================================
# Environment Variables — AI Chatbot
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# --- Server ---
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# --- PostgreSQL / Prisma ---
# Application/API connection. Use a pooled connection in production.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/ai_chatbot
# Optional direct/admin connection for Prisma migrations when your provider
# supplies separate pooled and direct URLs.
DIRECT_DATABASE_URL=

# --- Authentication ---
# Generate a long random value for production.
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_NAME=__Host-session
SESSION_TTL_DAYS=7

# --- LLM Provider (OpenAI) ---
# Keep this server-side. Never expose it through VITE_* variables.
LLM_API_KEY=sk-...your-key-here...
LLM_MODEL=gpt-4o-mini

# --- Distributed rate limiting ---
# Configure these when Redis/Upstash is enabled in Step 4.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Chat limits ---
CHAT_RATE_LIMIT_PER_MINUTE=30
CHAT_DAILY_REQUEST_LIMIT=50
MAX_MESSAGE_LENGTH=10000
