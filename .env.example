# =============================================================================
# Environment Variables — AI Chatbot
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# PostgreSQL / Prisma. Use a pooled connection in production.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/ai_chatbot
DIRECT_DATABASE_URL=

# Authentication. Use a long random value for production.
SESSION_SECRET=replace-with-a-long-random-secret
# Development: session. Production: __Host-session (requires Secure).
SESSION_COOKIE_NAME=session
SESSION_TTL_DAYS=7

# LLM providers — server-side only.
# OpenRouter remains available when the user selects OpenRouter.
LLM_API_KEY=sk-...your-openrouter-key-here...
LLM_MODEL=gpt-4o-mini

# Gemini 2.5 Flash
GOOGLE_GENERATIVE_AI_API_KEY=your-google-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Distributed rate limiting (Upstash Redis REST).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

CHAT_RATE_LIMIT_PER_MINUTE=30
CHAT_DAILY_REQUEST_LIMIT=50
MAX_MESSAGE_LENGTH=10000
