# =============================================================================
# Environment Variables — AI Chatbot
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/ai_chatbot
DIRECT_DATABASE_URL=

SESSION_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_NAME=session
SESSION_TTL_DAYS=7

LLM_API_KEY=sk-...your-openrouter-key-here...
LLM_MODEL=gpt-4o-mini
GOOGLE_GENERATIVE_AI_API_KEY=your-google-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
RAG_EMBEDDING_MODEL=gemini-embedding-001
RAG_EMBEDDING_DIMENSIONS=768
MAX_DOCUMENT_SIZE_BYTES=20971520

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CHAT_RATE_LIMIT_PER_MINUTE=30
CHAT_DAILY_REQUEST_LIMIT=50
MAX_MESSAGE_LENGTH=10000
