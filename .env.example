# =============================================================================
# Environment Variables — AI Chatbot
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
#
# WHY KEEP THIS ON THE BACKEND?
# Your LLM_API_KEY is like a password. If it ends up in your React app,
# anyone who opens DevTools can see it and use your account.
# Backend environment variables are NEVER sent to the browser.
# =============================================================================

# --- Server ---
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# --- LLM Provider (OpenAI) ---
# Get your key from: https://platform.openai.com/api-keys
LLM_API_KEY=sk-...your-key-here...

# Which OpenAI model to use.
# gpt-4o-mini  → Fast, cheap, great for most use cases
# gpt-4o       → More capable, costs more
LLM_MODEL=gpt-4o-mini
